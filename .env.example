# Pipances Configuration
# Copy to .env to override environment-specific settings.
#
# Path defaults are computed automatically from the project source location
# and work out of the box. Override any setting below with an absolute path
# (or a path relative to the current working directory at runtime).

# PIPANCES_DB_PATH=/absolute/path/to/pipances.db
# PIPANCES_STATIC_DIR=/absolute/path/to/static
# PIPANCES_IMPORTERS_DIR=/absolute/path/to/importers
# PIPANCES_TEMP_DIR=/tmp/pipances_imports
