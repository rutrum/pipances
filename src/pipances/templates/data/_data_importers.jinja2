{#
  SQL importer list.

  Tabulator runs in client mode over the embedded ``window.__IMPORTERS__``
  array; there is no ajaxURL. All CRUD traffic is JSON /api calls made by
  static/js/pages/importers.js. The builder lives on its own page
  (/data/importers/new, /data/importers/{id}/edit). No htmx here.
#}
{# djlint:off #}
<script>
  window.__IMPORTERS__ = {{ importers | tojson }};
</script>
{# djlint:on #}
<div class="flex justify-between items-center mb-4">
  <h2 class="text-lg font-semibold">SQL Importers</h2>
  <a id="importer-new"
     href="/data/importers/new"
     class="btn btn-primary btn-sm">
    <i data-lucide="plus" class="w-4 h-4"></i>
    New Importer
  </a>
</div>
<div id="importers-table"></div>
<script src="/static/js/pages/importers.js?v={{ js_version }}"></script>
