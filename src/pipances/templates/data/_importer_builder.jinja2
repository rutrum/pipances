{#
  Importer builder page content (create + edit modes).

  Rendered inside the Data layout by /data/importers/new and
  /data/importers/{id}/edit; driven entirely by
  static/js/pages/importer-builder.js. The `raw` relation is server-owned: the
  user's SQL references it directly and no preamble is displayed.

  Staged UX: the SQL fieldset and the results are hidden until a sample CSV is
  picked, at which point js runs `SELECT * FROM raw` and reveals the editor.

  Frozen ids (interface section 7): #importer-name, #importer-sql,
  #importer-file, #importer-run, #importer-save, #importer-error,
  #importer-preview, #importer-raw-schema, #importer-summary.
#}
{# djlint:off #}
<script>
  window.__IMPORTER__ = {{ importer | tojson }};
</script>
{# djlint:on #}
<div class="flex items-center justify-between mb-4">
  <h2 class="text-lg font-semibold">
    {% if importer %}
      Edit Importer
    {% else %}
      New Importer
    {% endif %}
  </h2>
  <div class="flex gap-2">
    <button type="button" id="importer-run" class="btn btn-secondary btn-sm">Run</button>
    <button type="button" id="importer-save" class="btn btn-primary btn-sm">Save</button>
    <a href="/data/importers" class="btn btn-ghost btn-sm">Cancel</a>
  </div>
</div>
<div class="space-y-4">
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Name</legend>
    <input type="text"
           id="importer-name"
           class="input w-full"
           placeholder="Example Bank"
           autocomplete="off" />
  </fieldset>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Sample CSV</legend>
    <input type="file"
           id="importer-file"
           class="file-input w-full"
           accept=".csv,text/csv" />
  </fieldset>
  <div id="importer-editor" class="space-y-4" hidden>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">
        SQL (a single SELECT over <code class="font-mono">raw</code>)
      </legend>
      <textarea id="importer-sql"
                class="textarea w-full h-72 font-mono text-sm"
                placeholder="SELECT CAST(date AS DATE) AS date, ... FROM raw"
                spellcheck="false"></textarea>
    </fieldset>
    <div id="importer-error"></div>
    <div id="importer-summary" class="text-sm text-base-content/70"></div>
    <div id="importer-raw-schema" class="overflow-x-auto"></div>
    <div id="importer-preview"
         class="overflow-x-auto max-h-96 overflow-y-auto"></div>
  </div>
</div>
<script src="/static/js/pages/importer-builder.js?v={{ js_version }}"></script>
