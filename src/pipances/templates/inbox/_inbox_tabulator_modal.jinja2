<dialog id="inbox-tabulator-edit-modal" class="modal">
  <div class="modal-box w-full max-w-2xl" data-txn-id="{{ txn.id }}">
    <div class="flex justify-between items-center mb-6">
      <h3 class="font-bold text-lg">Edit Transaction</h3>
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost">✕</button>
      </form>
    </div>
    <!-- Read-only transaction context -->
    <div class="mb-6 overflow-x-auto">
      <table class="table table-sm table-zebra">
        <tbody>
          <tr>
            <td class="w-1/3 font-semibold">Date</td>
            <td>{{ txn.date }}</td>
          </tr>
          <tr>
            <td class="font-semibold">Amount</td>
            <td class="font-mono {% if txn.amount_cents < 0 %}text-error{% else %}text-success{% endif %}">
              {{ "%.2f"|format(txn.amount_cents / 100) }}
            </td>
          </tr>
          <tr>
            <td class="font-semibold">Account</td>
            <td>{{ txn.internal.name }}</td>
          </tr>
          <tr>
            <td class="font-semibold">Raw Description</td>
            <td class="font-mono text-xs">{{ txn.raw_description }}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- Editable scalar fields; wired to the JSON PATCH endpoint by
         inbox-tabulator-modal.js, not the global HTMX combobox bootstrap. -->
    <div class="space-y-4">
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Description</span>
        </label>
        <select class="ts-json-select w-full"
                data-field="description"
                data-options='{{ descriptions | tojson }}'
                placeholder="Type to search..."
                autocomplete="off">
          {% if txn.description %}<option value="{{ txn.description }}" selected>{{ txn.description }}</option>{% endif %}
        </select>
      </div>
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">External Account</span>
        </label>
        {% set external_display = external_accounts|selectattr('id', 'equalto', txn.external_id)|map(attribute='name')|first or '' %}
        {% set external_names = external_accounts|map(attribute='name')|list %}
        <select class="ts-json-select w-full"
                data-field="external_id"
                data-options='{{ external_names | tojson }}'
                placeholder="Type to search..."
                autocomplete="off">
          {% if external_display %}<option value="{{ external_display }}" selected>{{ external_display }}</option>{% endif %}
        </select>
      </div>
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Category</span>
        </label>
        {% set category_display = categories|selectattr('id', 'equalto', txn.category_id)|map(attribute='name')|first or '' %}
        {% set category_names = categories|map(attribute='name')|list %}
        <select class="ts-json-select w-full"
                data-field="category_id"
                data-options='{{ category_names | tojson }}'
                placeholder="Type to search..."
                autocomplete="off">
          {% if category_display %}<option value="{{ category_display }}" selected>{{ category_display }}</option>{% endif %}
        </select>
      </div>
      {% include "shared/_splits_section.jinja2" %}
    </div>
    <div class="flex justify-center mt-8">
      <button type="button"
              class="btn {% if txn.marked_for_approval %}btn-warning{% else %}btn-primary{% endif %} btn-lg"
              data-modal-approve
              data-approve-value="{{ 'false' if txn.marked_for_approval else 'true' }}"
              {% if not txn.marked_for_approval and not (txn.description and txn.external) %}disabled{% endif %}>
        {{ 'Unapprove' if txn.marked_for_approval else 'Approve' }}
      </button>
    </div>
  </div>
  <!-- No backdrop close: this is an editing modal. Close via Escape or ✕. -->
</dialog>
