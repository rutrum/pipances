{% set txn_id = txn.id %}
{% set total_cents = txn.amount_cents | abs %}
{% set saved_sum = txn.splits | map(attribute='amount_cents') | sum %}
{% set combo_items_json = categories_data|tojson %}
<div id="splits-section-{{ txn_id }}" x-data="{ splitAmounts: {
  {% for s in txn.splits %}
    {{ s.id }}: {{ '%.2f' | format(s.amount_cents / 100) }},
  {% endfor %}
  }, newAmountDollars: '', get savedSumDollars() { return Object.values(this.splitAmounts).reduce((a, b) => a + (parseFloat(b) || 0), 0); }, get remainderDollars() { return ({{ total_cents / 100 }}) - this.savedSumDollars - (parseFloat(this.newAmountDollars) || 0); }, get canAdd() { const amt = parseFloat(this.newAmountDollars) || 0; return amt > 0 && amt < ({{ total_cents / 100 }}) - this.savedSumDollars; }, get hasSplits() { return Object.keys(this.splitAmounts).length > 0; } }">
  <div class="divider text-sm font-medium">Splits</div>
  {# Remainder row — shown only when splits exist #}
  <template x-if="hasSplits">
    <div class="flex items-center gap-2 mb-2 p-2 bg-base-200 rounded-box"
         data-remainder-row>
      <span class="font-semibold text-sm w-24">Remainder</span>
      <span class="font-mono text-sm"
            x-text="'$' + ({{ total_cents / 100 }} - savedSumDollars).toFixed(2)"></span>
      <span class="text-xs text-base-content/60">→ {{ txn.category.name if txn.category else 'Uncategorized' }}</span>
    </div>
  </template>
  {# Existing split rows #}
  {% for split in txn.splits %}
    <div class="flex items-center gap-2 mb-1 split-row-{{ split.id }}"
         data-split-row>
      <input type="number"
             step="0.01"
             min="0.01"
             class="input input-bordered input-sm w-24 font-mono"
             value="{{ '%.2f' | format(split.amount_cents / 100) }}"
             @input="splitAmounts[{{ split.id }}] = $event.target.value"
             hx-patch="/transactions/{{ txn_id }}/splits/{{ split.id }}"
             hx-trigger="blur"
             hx-target="#splits-section-{{ txn_id }}"
             hx-swap="outerHTML"
             name="amount_dollars" />
      {% set combo_value = split.category.name if split.category else '' %}
      {% set combo_placeholder = "Category" %}
      {% set combo_unique_id = "split-" ~ txn_id ~ "-" ~ split.id %}
      {% set combo_on_select_js %}
        htmx.ajax("PATCH", "/transactions/{{ txn_id }}/splits/{{ split.id }}", {
        target: "#splits-section-{{ txn_id }}",
        swap: "outerHTML",
        values: { category_id: item ? item.name : "" }
        });
      {% endset %}
      {% include "shared/_combo_alpine.jinja2" %}
      <button class="btn btn-ghost btn-xs text-error"
              hx-delete="/transactions/{{ txn_id }}/splits/{{ split.id }}"
              hx-target="#splits-section-{{ txn_id }}"
              hx-swap="outerHTML">✕</button>
    </div>
  {% endfor %}
  {# Add-split row #}
  <div id="add-split-{{ txn_id }}" class="flex items-center gap-2 mt-2">
    <input type="number"
           step="0.01"
           min="0.01"
           class="input input-bordered input-sm w-24 font-mono"
           placeholder="0.00"
           x-model="newAmountDollars"
           name="amount_dollars" />
    {% set combo_value = "" %}
    {% set combo_placeholder = "Category" %}
    {% set combo_unique_id = "add-split-" ~ txn_id %}
    {% set combo_on_select_js %}
    {% endset %}
    {% include "shared/_combo_alpine.jinja2" %}
    <button class="btn btn-primary btn-sm"
            disabled
            :disabled="!canAdd"
            hx-post="/transactions/{{ txn_id }}/splits"
            hx-target="#splits-section-{{ txn_id }}"
            hx-swap="outerHTML"
            hx-include="#add-split-{{ txn_id }}">Add Split</button>
  </div>
  {# Remainder warning — shown when remainder would be zero or negative #}
  <div x-show="remainderDollars <= 0 && (parseFloat(newAmountDollars) || 0) > 0"
       x-cloak
       class="text-error text-xs mt-1">Split would leave no remainder</div>
</div>
